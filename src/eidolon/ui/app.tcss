Screen { background: $background; }
FormModal { background: $background 30%; }
FormModal Input { margin: 0; background: $background; }
FormModal Select { margin: 0; }
#topbar { height: 1; background: $surface; padding: 0 2; }
#brand { width: auto; color: $primary; text-style: bold; }
#location { width: 1fr; text-align: right; color: $text-muted; }
#workspace, #pages, .page { height: 1fr; }
.page { padding: 1 2 0 2; }
.page-title { height: 1; margin-bottom: 1; color: $primary; text-style: bold; }
.section-title { height: 1; color: $secondary; margin-top: 1; }
.hint { height: auto; color: $text-muted; margin: 0 0 1 0; }
#conversation { height: 1fr; scrollbar-size: 1 1; }
.empty-chat { height: auto; margin: 2 0; color: $text-muted; }
.message-frame {
    height: auto; margin-bottom: 1; padding: 0 1; background: $surface;
    border: round $accent; border-title-color: $accent; border-title-style: bold;
    border-subtitle-align: right; border-subtitle-color: $text-muted; border-subtitle-style: none;
}
.message-frame.assistant-message { border: round $primary; border-title-color: $primary; }
.message { height: auto; margin: 0; padding: 0; background: transparent; }
.message-attachments { height: auto; color: $accent; text-style: italic; }
#turn-status { height: auto; max-height: 4; padding: 0 1; }
#thinking-spinner { display: none; width: 2; height: 1; color: $primary; }
#notice { width: 1fr; height: auto; max-height: 4; color: $text-muted; }
#notice.problem { color: $warning; }
#attachments { display: none; height: 1; color: $text-muted; padding: 0 1; }
#composer { height: 3; min-height: 3; max-height: 6; border: solid $panel; background: $surface; }
#composer:focus { border: solid $primary; }
#slash-suggestions { display: none; height: auto; max-height: 6; border: none; background: $surface; padding: 0 1; }
#service-status { height: 1; padding: 0 2; color: $text-muted; }
Footer { background: $surface; }
Input, Select { margin-bottom: 1; }
Input { border: none; height: 1; padding: 0 1; background: $surface; }
Input:focus { background: $panel; }
DataTable { height: 1fr; background: $background; }
DataTable > .datatable--header { background: $surface; color: $text-muted; text-style: none; }
DataTable > .datatable--cursor { background: $primary 30%; color: $text; text-style: bold; }
DataTable:focus > .datatable--cursor { background: $primary; color: $background; }
.editor { height: 1fr; border: none; background: $surface; }
.editor:focus { border-left: solid $primary; }
#prompt-pages { height: 1fr; }
#prompt-select { width: 100%; }
#too-small { display: none; height: auto; padding: 1; color: $text-muted; }
.too-small #workspace, .too-small #topbar, .too-small Footer { display: none; }
.too-small #too-small { display: block; }
.short .page { padding-top: 0; }
.short .page-title { margin-bottom: 0; }
.short .empty-chat { margin: 1 0; }
.short .message-frame { margin-bottom: 0; }
.short .hint { margin-bottom: 0; }
.narrow .page { padding-left: 1; padding-right: 1; }
.narrow #topbar, .narrow #service-status { padding: 0 1; }
.monochrome #brand, .monochrome .page-title, .monochrome #thinking-spinner,
.monochrome .section-title, .monochrome #notice.problem { color: $text; }
.monochrome .message-attachments { color: $foreground; }
.monochrome #composer:focus, .monochrome .editor:focus { border: solid $foreground; }
.monochrome .message-frame { border: round $foreground; border-title-color: $foreground; }
.ascii .message-frame { border: ascii $accent; }
.ascii .message-frame.assistant-message { border: ascii $primary; }
.ascii.monochrome .message-frame { border: ascii $foreground; }
.ascii #composer { border: ascii $panel; }
.ascii #composer:focus { border: ascii $primary; }
CommandMenu, HelpScreen { align: center middle; background: $background 70%; }
#command-dialog { width: 90%; max-width: 100; height: 80%; min-height: 8; padding: 1 2; background: $surface; }
.dialog-title { height: 1; margin-bottom: 1; color: $primary; text-style: bold; }
#command-input { height: 2; border-bottom: solid $primary; margin: 0; }
#command-options { height: 1fr; border: none; padding: 0; background: $surface; }
#command-hint { height: 1; margin: 1 0 0 0; }
#help-dialog { width: 90%; max-width: 110; height: 90%; padding: 1 2; background: $surface; }
#help-dialog VerticalScroll { height: 1fr; }
